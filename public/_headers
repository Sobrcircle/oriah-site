/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:; upgrade-insecure-requests

/
  Cache-Control: no-store, must-revalidate

/index.html
  Cache-Control: no-store, must-revalidate

/support/
  Cache-Control: no-store, must-revalidate

/privacy/
  Cache-Control: no-store, must-revalidate

/terms/
  Cache-Control: no-store, must-revalidate

/delete-account/
  Cache-Control: no-store, must-revalidate

/site.css
  Cache-Control: no-store, must-revalidate

/favicon-dark-64.png
  Cache-Control: public, max-age=3600, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*.png
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*.webp
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Universal / App Links association files (added 2026-09-15).
#
# Both were returning the SPA's index.html — Cloudflare Pages falls back to
# index.html for any path with no real file, so Android fetched
# assetlinks.json and got HTML, and iOS fetched the AASA and got HTML. Both
# platforms refuse to verify on that, which is why joinoriah.com links showed
# a chooser instead of opening the app despite the entitlement and the
# intent-filters being correct all along. Adding the real files fixes the
# fallback; these headers make the content type explicit rather than inherited.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=300
